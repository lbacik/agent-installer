{
  "name": "agent-installer",
  "version": "0.4.0",
  "description": "Install Codex skills and Claude Code skills and commands from a local repository.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "agent-installer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbacik/agent-installer.git"
  },
  "homepage": "https://github.com/lbacik/agent-installer",
  "bugs": {
    "url": "https://github.com/lbacik/agent-installer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1"
}
