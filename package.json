{
  "name": "agent-installer",
  "version": "0.9.0",
  "description": "Install Codex skills and Claude Code skills and commands from a local repository.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "agent-installer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "./scripts/smoke-test.sh",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbacik/agent-installer.git"
  },
  "homepage": "https://github.com/lbacik/agent-installer",
  "bugs": {
    "url": "https://github.com/lbacik/agent-installer/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "2.9.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
